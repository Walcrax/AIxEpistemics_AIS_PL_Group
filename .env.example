# Local Ollama (default endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Frontier API keys (set the providers you plan to evaluate / use as cross-family judge)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# API target endpoint (OpenAI-compatible; see scripts/api_models.py). Confidential: never commit or share.
LLM_BASE_URL=
LLM_API_KEY=
# Optional extra request headers, JSON object
LLM_EXTRA_HEADERS=
# Alias (configs/models.yaml) -> model name on the endpoint, JSON object, e.g. '{"grok-4.6": "<endpoint name>"}'
LLM_MODEL_MAP=
# Substitute credence judges on the same endpoint: judge alias (configs/models.yaml) -> model name, JSON object
JUDGE_MODEL_MAP=
